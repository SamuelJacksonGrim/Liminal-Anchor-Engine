      "description": "High-change regions of identity",
      "items": { "type": "string" }
    },
    "drift_vectors": {
      "type": "object",
      "description": "Direction of identity evolution",
      "additionalProperties": { "type": "number" }
    },
    "trajectory_history": {
      "type": "array",
      "description": "Append-only record of identity transitions",
      "items": { "type": "object" }
    }
  }
